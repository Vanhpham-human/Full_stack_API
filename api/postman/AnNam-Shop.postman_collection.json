    {
      "name": "Thêm sản phẩm hết hàng vào giỏ",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "const body = pm.response.json();",
          "const item = body.items.find((row) => row.productId === Number(pm.collectionVariables.get('productId2')));",
          "pm.collectionVariables.set('blockedItemId', String(item.id));",
          "pm.test('201 đã thêm dòng hết hàng', function () { pm.response.to.have.status(201); });"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
