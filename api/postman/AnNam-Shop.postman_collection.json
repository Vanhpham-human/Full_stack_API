          "  pm.expect(body.code).to.eql('ERR_STOCK_EMPTY');",
          "  pm.expect(body.message).to.eql('Sản phẩm đã hết hàng');",
          "  pm.expect(body.details).to.be.an('array').that.is.not.empty;",
          "});"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/orders"
      }
    },
    {
      "name": "Xóa dòng hết hàng",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('204', function () { pm.response.to.have.status(204); });"
        ] }
      }],
